# Backend origin the Next.js server proxies /api/* to (never exposed to the browser).
API_PROXY_TARGET=http://localhost:8000

# Leave empty for the recommended same-origin proxy. Set only if the browser
# must call a different API origin directly (not recommended: breaks cookies).
NEXT_PUBLIC_API_BASE_URL=

# Human-readable environment label shown in the portal header.
# development | staging | production
NEXT_PUBLIC_APP_ENV=development
