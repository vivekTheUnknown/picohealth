# Development defaults. Copy to .env and adjust.
ENVIRONMENT=development

# SQLite keeps local setup friction-free. Point at Postgres for parity:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/health_portal
DATABASE_URL=sqlite:///./portal.db

# Must be true anywhere other than local http development.
SECURE_COOKIES=false

# Only needed when the portal is on a different origin than the API.
ALLOWED_ORIGINS=["http://localhost:3000"]
